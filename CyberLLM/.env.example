# Copy to CyberLLM/.env. Shell variables take precedence over this file.
# Leave credentials empty to use the default Azure profile's offline fallback.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Optional providers; select one in config.yaml before supplying its key.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GITHUB_TOKEN=

# Optional incident-memory signing key; an empty value uses the existing
# development key. Set a private key before storing sensitive incidents.
# CYBERLLM_MEMORY_KEY=

# Offline overrides. Uncomment all three for deterministic local runs.
# These switches use nonempty-string checks: even "0" enables a switch.
# CYBERLLM_FORCE_STUB=1
# CYBERLLM_FORCE_DRY_RUN=1
# CYBERLLM_NO_EXTERNAL_STATIC=1
